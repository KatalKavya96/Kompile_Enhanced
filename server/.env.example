# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=8000
MONGO_URL=mongodb://localhost:27017/pod-platform

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password

# Only these email domains can sign up (email or Google)
ALLOWED_EMAIL_DOMAINS=nst.rishihood.edu.in

# Long random strings, different for each environment
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

RESEND_API_KEY=
MAIL_FROM=Pod Platform <no-reply@example.com>

CLIST_USERNAME=
CLIST_API_KEY=

# Optional rate-limit overrides (requests per window)
# AUTH_RATE_LIMIT=20      # per IP per 15 minutes
# SYNC_RATE_LIMIT=5       # per user per 10 minutes
# API_RATE_LIMIT=300      # per IP per minute
